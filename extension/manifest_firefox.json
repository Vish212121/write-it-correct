{
  "manifest_version": 3,
  "name": "write it correct",
  "version": "2.1.15",
  "description": "Live writing suggestions and rewrites for browser text fields, powered by your Groq API key.",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "host_permissions": [
    "<all_urls>",
    "https://api.groq.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "js": ["selection-geometry.js", "request-errors.js", "suggestion-logic.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gembar@local.assistant",
      "strict_min_version": "115.0"
    }
  }
}
